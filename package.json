{
  "name": "out-of-credits",
  "private": true,
  "version": "0.1.0",
  "description": "A 90s comic-book game where the only controller is a unix terminal. Kiroween 2026.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recferret-bit/OutOfCredits.git"
  },
  "keywords": [
    "game",
    "terminal",
    "unix",
    "comic",
    "threejs",
    "xterm",
    "kiro",
    "kiroween"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/harness/stack.mjs start",
    "stop": "node scripts/harness/stack.mjs stop",
    "restart": "node scripts/harness/stack.mjs restart",
    "status": "node scripts/harness/stack.mjs status",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "quality:size": "node scripts/quality/check-size.mjs src scripts/desktop",
    "quality:layers": "node scripts/quality/check-layers.mjs",
    "quality:declarative": "node scripts/quality/check-declarative.mjs",
    "quality:dup": "jscpd src scripts/desktop --min-lines 4 --min-tokens 35 --threshold 0 --reporters console --format typescript,javascript --ignore \"**/chapters/generated/**,**/cinematic/generated/**\"",
    "quality:fingerprint": "node scripts/quality/fingerprint.mjs",
    "quality": "tsc --noEmit && npm run quality:root && npm run quality:size && npm run quality:layers && npm run quality:declarative && npm run quality:specs && npm run quality:dup && npm run quality:agents && npm run quality:legacy-name && npm run quality:brands && npm run quality:mcp && npm run quality:props",
    "quality:root": "node scripts/quality/check-root.mjs",
    "quality:specs": "node scripts/quality/check-specs.mjs",
    "quality:legacy-name": "node scripts/quality/check-legacy-name.mjs",
    "quality:brands": "node scripts/quality/check-brands.mjs",
    "quality:props": "node scripts/harness/property-tests.mjs",
    "quality:mcp": "node scripts/harness/forge-unit.mjs",
    "quality:agents": "node scripts/quality/check-agents.mjs && node scripts/harness/agents-unit.mjs",
    "agents:install": "node scripts/harness/agents-install.mjs",
    "crew:check": "node scripts/harness/crew-doctor.mjs",
    "desktop:generate": "node scripts/desktop/generate-tauri-steam.mjs",
    "desktop:verify": "node scripts/desktop/verify-desktop-bundle.mjs",
    "desktop:build": "node scripts/desktop/build-tauri-steam.mjs",
    "desktop:test": "node scripts/desktop/desktop-unit.mjs && node scripts/desktop/landing-smoke.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/three": "^0.180.0",
    "chrome-devtools-mcp": "1.13.0",
    "fast-check": "4.10.2",
    "jscpd": "5.4.3",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "zod": "4.6.7"
  }
}
