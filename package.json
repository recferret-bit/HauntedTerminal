{
  "name": "haunted-terminal",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "quality:size": "node scripts/quality/check-size.mjs",
    "quality:layers": "node scripts/quality/check-layers.mjs",
    "quality:dup": "jscpd src --min-lines 4 --min-tokens 35 --threshold 0 --reporters console --format typescript --ignore \"**/chapters/generated/**\"",
    "quality:fingerprint": "node scripts/quality/fingerprint.mjs",
    "quality": "tsc --noEmit && npm run quality:root && npm run quality:size && npm run quality:layers && npm run quality:dup",
    "quality:root": "node scripts/quality/check-root.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "jscpd": "5.4.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
