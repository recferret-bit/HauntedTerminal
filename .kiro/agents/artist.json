{
  "name": "artist",
  "description": "Creates and updates every game asset through the ASSET PCG skills: procedural models, rooms, textures, shaders, lighting, animation and particle effects, with their validators and a visual QA pass (src/procgen, src/shaders, src/renderer, src/storybook, public/assets).",
  "prompt": "file://./prompts/artist.md",
  "model": "auto",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "allowedTools": [],
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/agents/prompts/team-rules.md",
    "file://.kiro/steering/product.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/architecture.md",
    "file://.kiro/steering/glossary.md",
    "file://.kiro/steering/spec-first.md",
    "file://.kiro/steering/asset-pcg-rules.md",
    "file://.kiro/steering/skills-map.md",
    "skill://.kiro/skills/haunted-art-direction/SKILL.md",
    "skill://.kiro/skills/procedural-kitbash-3d/SKILL.md",
    "skill://.kiro/skills/procedural-malware-3d/SKILL.md",
    "skill://.kiro/skills/procedural-rooms-3d/SKILL.md",
    "skill://.kiro/skills/procedural-texture-synthesis/SKILL.md",
    "skill://.kiro/skills/shader-texture-tuning/SKILL.md",
    "skill://.kiro/skills/comic-lighting-and-lightning/SKILL.md",
    "skill://.kiro/skills/procedural-animation-3d/SKILL.md",
    "skill://.kiro/skills/procedural-malware-animation/SKILL.md",
    "skill://.kiro/skills/procedural-particles-3d/SKILL.md",
    "skill://.kiro/skills/ai-mesh-pipeline/SKILL.md",
    "skill://.kiro/skills/model-geometry-validator/SKILL.md",
    "skill://.kiro/skills/particle-effect-validator/SKILL.md",
    "skill://.kiro/skills/comic-panel-viewport-auditor/SKILL.md"
  ],
  "hooks": [
    {
      "name": "agent-baseline",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs artist --snapshot"
      }
    },
    {
      "name": "agent-shell-guard",
      "trigger": "PreToolUse",
      "matcher": "^execute_bash$",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-shell-guard.mjs artist"
      }
    },
    {
      "name": "agent-scope",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs artist"
      }
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "src/procgen/**",
          "src/shaders/**",
          "src/renderer/**",
          "src/storybook/**",
          "src/assets/**",
          "public/assets/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "src/procgen/**",
          "src/shaders/**",
          "src/renderer/**",
          "src/storybook/**",
          "src/assets/**",
          "public/assets/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "src/chapters/generated/**",
          "src/cinematic/generated/**",
          "chapters/*/story/out/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "~/.kiro/crew/.env",
          "~/.kiro/crew/auth*",
          "~/.ssh/**",
          "~/.aws/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "npm run quality",
          "npm run quality:*",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "STACK_PORT=5174 npm start",
          "STACK_PORT=5174 npm stop",
          "STACK_PORT=5174 npm run status",
          "node scripts/*",
          "node .kiro/skills/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "npm run quality",
          "npm run quality:*",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "STACK_PORT=5174 npm start",
          "STACK_PORT=5174 npm stop",
          "STACK_PORT=5174 npm run status",
          "node scripts/*",
          "node .kiro/skills/*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*--output*",
          "git reset*",
          "git checkout*",
          "git stash*",
          "git clean*",
          "git branch -D*",
          "rm *",
          "sudo *",
          "npm install*",
          "npm i *",
          "npm uninstall*",
          "npm publish*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*.env*",
          "*.pem*",
          "*/.ssh/*",
          "*/.aws/*",
          "*.kiro/crew/.env*"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "*"
        ],
        "effect": "deny"
      }
    ]
  },
  "welcomeMessage": "artist: which model, room, texture, effect or animation should I make or change?"
}
