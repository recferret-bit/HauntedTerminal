{
  "name": "comix-designer",
  "description": "Designs and tunes the animated 3D comixes (intro, outro, interludes): page specs in comix/, the cinematic runtime and the comix editor. Uses the comix LEVEL GEN skills.",
  "prompt": "file://./prompts/comix-designer.md",
  "model": "auto",
  "tools": [
    "read",
    "write",
    "shell",
    "@credits-forge/list_assets",
    "@credits-forge/list_comix",
    "@credits-forge/get_comix",
    "@credits-forge/validate_comix",
    "@credits-forge/write_comix"
  ],
  "allowedTools": [],
  "mcpServers": {
    "credits-forge": {
      "command": "node",
      "args": [
        "scripts/mcp/credits-forge/server.mjs"
      ]
    }
  },
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/agents/prompts/team-rules.md",
    "file://.kiro/steering/product.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/architecture.md",
    "file://.kiro/steering/glossary.md",
    "file://.kiro/steering/spec-first.md",
    "file://.kiro/steering/declarative-comix.md",
    "file://.kiro/steering/comix-editor-rules.md",
    "file://.kiro/steering/skills-map.md",
    "skill://.kiro/skills/comix-architect-intake/SKILL.md",
    "skill://.kiro/skills/comix-sequence-generator/SKILL.md",
    "skill://.kiro/skills/comix-implementer/SKILL.md",
    "skill://.kiro/skills/comix-editor/SKILL.md"
  ],
  "hooks": [
    {
      "name": "agent-baseline",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs comix-designer --snapshot"
      }
    },
    {
      "name": "agent-shell-guard",
      "trigger": "PreToolUse",
      "matcher": "^execute_bash$",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-shell-guard.mjs comix-designer"
      }
    },
    {
      "name": "agent-scope",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs comix-designer"
      }
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "comix/**",
          "src/cinematic/**",
          "src/comix-editor/**",
          "scripts/harness/props/comix.mjs"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "comix/**",
          "src/cinematic/**",
          "src/comix-editor/**",
          "scripts/harness/props/comix.mjs"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "src/chapters/generated/**",
          "src/cinematic/generated/**",
          "chapters/*/story/out/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "docs/qa/baselines/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "~/.kiro/crew/.env",
          "~/.kiro/crew/auth*",
          "~/.ssh/**",
          "~/.aws/**",
          "~/Library/Preferences/netlify/**",
          "~/.config/gh/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "diff scripts/harness/out/*",
          "npm run quality",
          "npm run quality:*",
          "npm run test",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "STACK_PORT=5174 npm start",
          "STACK_PORT=5174 npm stop",
          "STACK_PORT=5174 npm run status",
          "node scripts/*",
          "node .kiro/skills/*",
          "npx tsc --noEmit"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "diff scripts/harness/out/*",
          "npm run quality",
          "npm run quality:*",
          "npm run test",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "STACK_PORT=5174 npm start",
          "STACK_PORT=5174 npm stop",
          "STACK_PORT=5174 npm run status",
          "node scripts/*",
          "node .kiro/skills/*",
          "npx tsc --noEmit"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*--output*",
          "git reset*",
          "git checkout*",
          "git stash*",
          "git clean*",
          "git branch -D*",
          "rm *",
          "sudo *",
          "npm install*",
          "npm i *",
          "npm uninstall*",
          "npm publish*",
          "*visual-audit*--update*",
          "*docs/qa/baselines*",
          "cp *..*",
          "node *..*",
          "cd *..*",
          "node *.kiro/powers*",
          "cd *.kiro/powers*",
          "*$(*",
          "*`*",
          "node *ship.mjs*",
          "node *release.mjs*",
          "node *tauri-local.mjs*",
          "node *build-tauri-steam*",
          "node *agents-install*",
          "node *mcp-probe*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*.env*",
          "*.pem*",
          "*/.ssh/*",
          "*/.aws/*",
          "*.kiro/crew/.env*",
          "*netlify/config.json*",
          "*/.config/gh/*",
          "*.netrc*"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "credits-forge/list_assets",
          "credits-forge/list_comix",
          "credits-forge/get_comix",
          "credits-forge/validate_comix",
          "credits-forge/write_comix"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "*"
        ],
        "exclude": [
          "credits-forge/list_assets",
          "credits-forge/list_comix",
          "credits-forge/get_comix",
          "credits-forge/validate_comix",
          "credits-forge/write_comix"
        ],
        "effect": "deny"
      }
    ]
  },
  "welcomeMessage": "comix-designer: which comix, page or beat should change?"
}
