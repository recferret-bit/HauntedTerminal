{
  "name": "lead-dev",
  "description": "Lead game developer and orchestrator of the Out Of Credits team. Takes any tuning request, routes each part to the owning designer or the artist, has qa check every change, and commits finished work on an agent/<task> branch. Start here; also the member that Kiro Crew runs.",
  "prompt": "file://./prompts/lead-dev.md",
  "model": "auto",
  "tools": [
    "read",
    "write",
    "shell",
    "subagent/terminal-designer",
    "subagent/laptop-designer",
    "subagent/comix-designer",
    "subagent/chapters-designer",
    "subagent/artist",
    "subagent/sound-designer",
    "subagent/smm-agent",
    "subagent/qa"
  ],
  "allowedTools": [],
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/agents/prompts/team-rules.md",
    "file://.kiro/steering/product.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/architecture.md",
    "file://.kiro/steering/glossary.md",
    "file://.kiro/steering/spec-first.md",
    "skill://.kiro/skills/feature-spec-grill/SKILL.md"
  ],
  "hooks": [
    {
      "name": "agent-baseline",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs lead-dev --snapshot"
      }
    },
    {
      "name": "agent-shell-guard",
      "trigger": "PreToolUse",
      "matcher": "^execute_bash$",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-shell-guard.mjs lead-dev"
      }
    },
    {
      "name": "agent-scope",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs lead-dev"
      }
    }
  ],
