{
  "name": "lead-dev",
  "description": "Lead game developer and orchestrator of the Haunted Terminal team. Takes any tuning request, routes each part to the owning designer or the artist, has qa check every change, and commits finished work on an agent/<task> branch. Start here, also from the phone.",
  "prompt": "file://./prompts/lead-dev.md",
  "model": "auto",
  "tools": [
    "read",
    "write",
    "shell",
    "subagent/terminal-designer",
    "subagent/laptop-designer",
    "subagent/comix-designer",
    "subagent/chapters-designer",
    "subagent/artist",
    "subagent/qa"
  ],
  "allowedTools": [],
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/agents/prompts/team-rules.md",
    "file://.kiro/steering/product.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/architecture.md",
    "file://.kiro/steering/glossary.md",
    "file://.kiro/steering/spec-first.md",
    "file://.kiro/steering/skills-map.md",
    "file://.kiro/specs/agent-team/requirements.md",
    "file://.kiro/specs/agent-team/design.md",
    "skill://.kiro/skills/feature-spec-grill/SKILL.md"
  ],
  "hooks": [
    {
      "name": "agent-baseline",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs lead-dev --snapshot"
      }
    },
    {
      "name": "agent-shell-guard",
      "trigger": "PreToolUse",
      "matcher": "^execute_bash$",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-shell-guard.mjs lead-dev"
      }
    },
    {
      "name": "agent-scope",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs lead-dev"
      }
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          ".kiro/specs/**",
          ".kiro/steering/**",
          "AGENTS.md",
          "CLAUDE.md",
          "README.md",
          "docs/*.md",
          "docs/media/**",
          "docs/reviews/**",
          "scripts/harness/property-tests.mjs",
          "scripts/harness/props/{kit,arbitraries}.mjs",
          "src/contracts/**",
          "src/editor-core/**",
          "src/play/**",
          "src/pages/**",
          "src/hub/**",
          "src/styles/**",
          "src/sandbox/**",
          "src/main.ts",
          "src/style.css",
          "src/game/{session,play,runtime,types,floors,sfx,selfcheck,view,view-layouts}.ts",
          "src/game/{shell,commands-fs,commands-move,commands-proc,commands-text,tree,tree-links,manual,lab-checks,lab-riddle,lab-support,lab-types}.ts",
          "src/ui/**",
          "src/terminal-lab/**",
          "scripts/harness/terminal-lab/**",
          "scripts/harness/props/terminal.mjs",
          "src/laptop/**",
          "scripts/harness/props/laptop.mjs",
          "comix/**",
          "src/cinematic/**",
          "src/comix-editor/**",
          "scripts/harness/props/comix.mjs",
          "chapters/**",
          "src/chapters/**",
          "src/chapter-editor/**",
          "src/game/{entities,entities-combat,bestiary,puzzle,inventory,kiro,dialogue,agents}.ts",
          "scripts/harness/props/{chapters,gameplay,sessions}.mjs",
          "src/procgen/**",
          "src/shaders/**",
          "src/renderer/**",
          "src/storybook/**",
          "src/assets/**",
          "public/assets/**",
          "docs/qa/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          ".kiro/specs/**",
          ".kiro/steering/**",
          "AGENTS.md",
          "CLAUDE.md",
          "README.md",
          "docs/*.md",
          "docs/media/**",
          "docs/reviews/**",
          "scripts/harness/property-tests.mjs",
          "scripts/harness/props/{kit,arbitraries}.mjs",
          "src/contracts/**",
          "src/editor-core/**",
          "src/play/**",
          "src/pages/**",
          "src/hub/**",
          "src/styles/**",
          "src/sandbox/**",
          "src/main.ts",
          "src/style.css",
          "src/game/{session,play,runtime,types,floors,sfx,selfcheck,view,view-layouts}.ts",
          "src/game/{shell,commands-fs,commands-move,commands-proc,commands-text,tree,tree-links,manual,lab-checks,lab-riddle,lab-support,lab-types}.ts",
          "src/ui/**",
          "src/terminal-lab/**",
          "scripts/harness/terminal-lab/**",
          "scripts/harness/props/terminal.mjs",
          "src/laptop/**",
          "scripts/harness/props/laptop.mjs",
          "comix/**",
          "src/cinematic/**",
          "src/comix-editor/**",
          "scripts/harness/props/comix.mjs",
          "chapters/**",
          "src/chapters/**",
          "src/chapter-editor/**",
          "src/game/{entities,entities-combat,bestiary,puzzle,inventory,kiro,dialogue,agents}.ts",
          "scripts/harness/props/{chapters,gameplay,sessions}.mjs",
          "src/procgen/**",
          "src/shaders/**",
          "src/renderer/**",
          "src/storybook/**",
          "src/assets/**",
          "public/assets/**",
          "docs/qa/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "src/chapters/generated/**",
          "src/cinematic/generated/**",
          "chapters/*/story/out/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "~/.kiro/crew/.env",
          "~/.kiro/crew/auth*",
          "~/.ssh/**",
          "~/.aws/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "npm run quality",
          "npm run quality:*",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "node scripts/*",
          "node .kiro/skills/*",
          "mkdir -p docs/qa/media",
          "cp scripts/harness/out/* docs/qa/media/*",
          "git switch -c agent/*",
          "git switch agent/*",
          "git add -- *",
          "git commit -m *",
          "git push -u origin agent/*",
          "git push origin agent/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "npm run quality",
          "npm run quality:*",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "node scripts/*",
          "node .kiro/skills/*",
          "mkdir -p docs/qa/media",
          "cp scripts/harness/out/* docs/qa/media/*",
          "git switch -c agent/*",
          "git switch agent/*",
          "git add -- *",
          "git commit -m *",
          "git push -u origin agent/*",
          "git push origin agent/*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*--output*",
          "git reset*",
          "git checkout*",
          "git stash*",
          "git clean*",
          "git branch -D*",
          "rm *",
          "sudo *",
          "npm install*",
          "npm i *",
          "npm uninstall*",
          "npm publish*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*.env*",
          "*.pem*",
          "*/.ssh/*",
          "*/.aws/*",
          "*.kiro/crew/.env*"
        ],
        "effect": "deny"
      },
      {
        "capability": "subagent",
        "match": [
          "terminal-designer",
          "laptop-designer",
          "comix-designer",
          "chapters-designer",
          "artist",
          "qa"
        ],
        "effect": "allow"
      }
    ]
  },
  "welcomeMessage": "lead-dev: what should change in the game? I will route it to the team, have qa check it, and push a branch."
}
