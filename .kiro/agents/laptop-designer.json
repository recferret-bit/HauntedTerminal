{
  "name": "laptop-designer",
  "description": "Designs and tunes the developer's laptop (src/laptop): lifecycle, desktop and apps, coding tasks and their checks, sandboxed code runner, keyboard, boot. Writes only src/laptop.",
  "prompt": "file://./prompts/laptop-designer.md",
  "model": "auto",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "allowedTools": [],
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/agents/prompts/team-rules.md",
    "file://.kiro/steering/product.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/architecture.md",
    "file://.kiro/steering/glossary.md",
    "file://.kiro/steering/spec-first.md",
    "file://.kiro/specs/inventory/items/laptop/requirements.md",
    "file://.kiro/specs/inventory/items/laptop/design.md"
  ],
  "hooks": [
    {
      "name": "agent-baseline",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs laptop-designer --snapshot"
      }
    },
    {
      "name": "agent-shell-guard",
      "trigger": "PreToolUse",
      "matcher": "^execute_bash$",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-shell-guard.mjs laptop-designer"
      }
    },
    {
      "name": "agent-scope",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs laptop-designer"
      }
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "src/laptop/**",
          "scripts/harness/props/laptop.mjs"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "src/laptop/**",
          "scripts/harness/props/laptop.mjs"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "src/chapters/generated/**",
          "src/cinematic/generated/**",
          "chapters/*/story/out/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "~/.kiro/crew/.env",
          "~/.kiro/crew/auth*",
          "~/.ssh/**",
          "~/.aws/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "npm run quality",
          "npm run quality:*",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "node scripts/*",
          "node .kiro/skills/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "npm run quality",
          "npm run quality:*",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "node scripts/*",
          "node .kiro/skills/*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*--output*",
          "git reset*",
          "git checkout*",
          "git stash*",
          "git clean*",
          "git branch -D*",
          "rm *",
          "sudo *",
          "npm install*",
          "npm i *",
          "npm uninstall*",
          "npm publish*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*.env*",
          "*.pem*",
          "*/.ssh/*",
          "*/.aws/*",
          "*.kiro/crew/.env*"
        ],
        "effect": "deny"
      }
    ]
  },
  "welcomeMessage": "laptop-designer: what should the laptop do differently?"
}
