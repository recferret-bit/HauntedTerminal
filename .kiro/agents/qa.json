{
  "name": "qa",
  "description": "Plays Out Of Credits and tests every part of it: the chapter in real Chrome, the terminal, laptop, comixes, editors, labs and assets, through the harness suites and screenshots. Writes a report to docs/qa/ and changes no game file.",
  "prompt": "file://./prompts/qa.md",
  "model": "auto",
  "tools": [
    "read",
    "write",
    "shell",
    "@chrome-devtools/list_pages",
    "@chrome-devtools/new_page",
    "@chrome-devtools/select_page",
    "@chrome-devtools/navigate_page",
    "@chrome-devtools/close_page",
    "@chrome-devtools/resize_page",
    "@chrome-devtools/wait_for",
    "@chrome-devtools/take_screenshot",
    "@chrome-devtools/take_snapshot",
    "@chrome-devtools/list_console_messages",
    "@chrome-devtools/get_console_message",
    "@chrome-devtools/list_network_requests",
    "@chrome-devtools/get_network_request",
    "@chrome-devtools/click",
    "@chrome-devtools/hover",
    "@chrome-devtools/fill",
    "@chrome-devtools/type_text",
    "@chrome-devtools/press_key",
    "@chrome-devtools/emulate",
    "@chrome-devtools/performance_start_trace",
    "@chrome-devtools/performance_stop_trace",
    "@chrome-devtools/performance_analyze_insight",
    "@credits-forge/list_assets",
    "@credits-forge/list_levels",
    "@credits-forge/get_level",
    "@credits-forge/validate_level",
    "@credits-forge/solve_level"
  ],
  "allowedTools": [],
  "mcpServers": {
    "chrome-devtools": {
      "command": "node",
      "args": [
        "node_modules/chrome-devtools-mcp/out/Default/gen/src/bin/chrome-devtools-mcp.js",
        "--headless",
        "--isolated",
        "--viewport",
        "1280x800",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--no-javascript-evaluation",
        "--no-file-navigations",
        "--workspace",
        "scripts/harness/out",
        "--allowedUrlPattern",
        "http://localhost:*/*",
        "--allowedUrlPattern",
        "http://127.0.0.1:*/*",
        "--allowedUrlPattern",
        "https://*.netlify.app/*"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "NODE_COMPILE_CACHE": "scripts/harness/out/.node-compile-cache"
      },
      "timeout": 120000
    },
    "credits-forge": {
      "command": "node",
      "args": [
        "scripts/mcp/credits-forge/server.mjs"
      ]
    }
  },
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/agents/prompts/team-rules.md",
    "file://.kiro/steering/product.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/architecture.md",
    "file://.kiro/steering/glossary.md",
    "file://.kiro/steering/spec-first.md",
    "file://.kiro/steering/declarative-chapters.md",
    "file://.kiro/steering/declarative-comix.md",
    "file://.kiro/steering/terminal-lab-rules.md",
    "skill://.kiro/skills/comic-panel-viewport-auditor/SKILL.md",
    "skill://.kiro/skills/chapter-implementer/SKILL.md",
    "skill://.kiro/skills/comix-implementer/SKILL.md",
    "skill://.kiro/skills/model-geometry-validator/SKILL.md",
    "skill://.kiro/skills/particle-effect-validator/SKILL.md"
  ],
  "hooks": [
    {
      "name": "agent-baseline",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs qa --snapshot"
      }
    },
    {
      "name": "agent-shell-guard",
      "trigger": "PreToolUse",
      "matcher": "^execute_bash$",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-shell-guard.mjs qa"
      }
    },
    {
      "name": "devtools-url-guard",
      "trigger": "PreToolUse",
      "matcher": "@chrome-devtools",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/devtools-url-guard.mjs qa"
      }
    },
    {
      "name": "agent-scope",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs qa"
      }
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "docs/qa/*.md",
          "docs/qa/media/**",
          "docs/qa/labs/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "docs/qa/*.md",
          "docs/qa/media/**",
          "docs/qa/labs/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "src/chapters/generated/**",
          "src/cinematic/generated/**",
          "chapters/*/story/out/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "docs/qa/baselines/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "~/.kiro/crew/.env",
          "~/.kiro/crew/auth*",
          "~/.ssh/**",
          "~/.aws/**",
          "~/Library/Preferences/netlify/**",
          "~/.config/gh/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "diff scripts/harness/out/*",
          "npm run quality",
          "npm run quality:*",
          "npm run test",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "STACK_PORT=5174 npm start",
          "STACK_PORT=5174 npm stop",
          "STACK_PORT=5174 npm run status",
          "node scripts/*",
          "node .kiro/skills/*",
          "npx tsc --noEmit",
          "mkdir -p docs/qa/media",
          "cp scripts/harness/out/* docs/qa/media/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "diff scripts/harness/out/*",
          "npm run quality",
          "npm run quality:*",
          "npm run test",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "STACK_PORT=5174 npm start",
          "STACK_PORT=5174 npm stop",
          "STACK_PORT=5174 npm run status",
          "node scripts/*",
          "node .kiro/skills/*",
          "npx tsc --noEmit",
          "mkdir -p docs/qa/media",
          "cp scripts/harness/out/* docs/qa/media/*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*--output*",
          "git reset*",
          "git checkout*",
          "git stash*",
          "git clean*",
          "git branch -D*",
          "rm *",
          "sudo *",
          "npm install*",
          "npm i *",
          "npm uninstall*",
          "npm publish*",
          "*visual-audit*--update*",
          "*docs/qa/baselines*",
          "cp *..*",
          "node *..*",
          "cd *..*",
          "node *.kiro/powers*",
          "cd *.kiro/powers*",
          "*$(*",
          "*`*",
          "node *ship.mjs*",
          "node *release.mjs*",
          "node *tauri-local.mjs*",
          "node *build-tauri-steam*",
          "node *agents-install*",
          "node *mcp-probe*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*.env*",
          "*.pem*",
          "*/.ssh/*",
          "*/.aws/*",
          "*.kiro/crew/.env*",
          "*netlify/config.json*",
          "*/.config/gh/*",
          "*.netrc*"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "chrome-devtools/list_pages",
          "chrome-devtools/new_page",
          "chrome-devtools/select_page",
          "chrome-devtools/navigate_page",
          "chrome-devtools/close_page",
          "chrome-devtools/resize_page",
          "chrome-devtools/wait_for",
          "chrome-devtools/take_screenshot",
          "chrome-devtools/take_snapshot",
          "chrome-devtools/list_console_messages",
          "chrome-devtools/get_console_message",
          "chrome-devtools/list_network_requests",
          "chrome-devtools/get_network_request",
          "chrome-devtools/click",
          "chrome-devtools/hover",
          "chrome-devtools/fill",
          "chrome-devtools/type_text",
          "chrome-devtools/press_key",
          "chrome-devtools/emulate",
          "chrome-devtools/performance_start_trace",
          "chrome-devtools/performance_stop_trace",
          "chrome-devtools/performance_analyze_insight",
          "credits-forge/list_assets",
          "credits-forge/list_levels",
          "credits-forge/get_level",
          "credits-forge/validate_level",
          "credits-forge/solve_level"
        ],
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "*"
        ],
        "exclude": [
          "chrome-devtools/list_pages",
          "chrome-devtools/new_page",
          "chrome-devtools/select_page",
          "chrome-devtools/navigate_page",
          "chrome-devtools/close_page",
          "chrome-devtools/resize_page",
          "chrome-devtools/wait_for",
          "chrome-devtools/take_screenshot",
          "chrome-devtools/take_snapshot",
          "chrome-devtools/list_console_messages",
          "chrome-devtools/get_console_message",
          "chrome-devtools/list_network_requests",
          "chrome-devtools/get_network_request",
          "chrome-devtools/click",
          "chrome-devtools/hover",
          "chrome-devtools/fill",
          "chrome-devtools/type_text",
          "chrome-devtools/press_key",
          "chrome-devtools/emulate",
          "chrome-devtools/performance_start_trace",
          "chrome-devtools/performance_stop_trace",
          "chrome-devtools/performance_analyze_insight",
          "credits-forge/list_assets",
          "credits-forge/list_levels",
          "credits-forge/get_level",
          "credits-forge/validate_level",
          "credits-forge/solve_level"
        ],
        "effect": "deny"
      }
    ]
  },
  "welcomeMessage": "qa: which features should I play and test? (default: a full pass)"
}
