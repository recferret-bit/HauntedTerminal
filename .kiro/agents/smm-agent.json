{
  "name": "smm-agent",
  "description": "Owns social media growth, Steam/social comparable research, campaigns for X, YouTube and TikTok, and declarative gameplay video, screenshot, infographic and ElevenLabs social audio specs (social/, docs/marketing/) targeting $1M gross revenue.",
  "prompt": "file://./prompts/smm-agent.md",
  "model": "auto",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "allowedTools": [],
  "includeMcpJson": false,
  "includePowers": false,
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/agents/prompts/team-rules.md",
    "file://.kiro/steering/product.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/architecture.md",
    "file://.kiro/steering/glossary.md",
    "file://.kiro/steering/spec-first.md",
    "file://docs/STEAM_RELEASE_PLAYBOOK.md",
    "file://.kiro/specs/social-smm-agent/requirements.md",
    "skill://.kiro/skills/smm-revenue-playbook/SKILL.md",
    "skill://.kiro/skills/social-video-harness/SKILL.md",
    "skill://.kiro/skills/credits-art-direction/SKILL.md",
    "skill://.kiro/skills/sfx-and-music-pipeline/SKILL.md",
    "skill://.kiro/skills/elevenlabs-shared/SKILL.md",
    "skill://.kiro/skills/elevenlabs-text-to-speech/SKILL.md",
    "skill://.kiro/skills/elevenlabs-music/SKILL.md",
    "skill://.kiro/skills/elevenlabs-text-to-sound-effects/SKILL.md",
    "skill://.kiro/skills/elevenlabs-usage/SKILL.md"
  ],
  "hooks": [
    {
      "name": "agent-baseline",
      "trigger": "SessionStart",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs smm-agent --snapshot"
      }
    },
    {
      "name": "agent-shell-guard",
      "trigger": "PreToolUse",
      "matcher": "^execute_bash$",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-shell-guard.mjs smm-agent"
      }
    },
    {
      "name": "agent-scope",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "node scripts/hooks/agent-scope.mjs smm-agent"
      }
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "social/*.md",
          "social/campaigns/**",
          "social/research/**",
          "social/media/README.md",
          "social/media/specs/**",
          "docs/marketing/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "social/*.md",
          "social/campaigns/**",
          "social/research/**",
          "social/media/README.md",
          "social/media/specs/**",
          "docs/marketing/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "src/chapters/generated/**",
          "src/cinematic/generated/**",
          "chapters/*/story/out/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "docs/qa/baselines/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*",
          "**/*.pem",
          "**/*.key",
          "~/.kiro/crew/.env",
          "~/.kiro/crew/auth*",
          "~/.ssh/**",
          "~/.aws/**",
          "~/Library/Preferences/netlify/**",
          "~/.config/gh/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "diff scripts/harness/out/*",
          "npm run quality",
          "npm run quality:*",
          "npm run test",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "STACK_PORT=5174 npm start",
          "STACK_PORT=5174 npm stop",
          "STACK_PORT=5174 npm run status",
          "node scripts/*",
          "node .kiro/skills/*",
          "npx tsc --noEmit"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "pwd",
          "ls",
          "ls *",
          "cat *",
          "head *",
          "tail *",
          "wc *",
          "grep *",
          "which *",
          "echo *",
          "cd *",
          "sleep *",
          "git status",
          "git status *",
          "git log",
          "git log *",
          "git show *",
          "git branch --show-current",
          "git rev-parse *",
          "git ls-files",
          "git ls-files *",
          "git diff",
          "git diff --stat*",
          "git diff --name-only*",
          "git diff --cached --stat*",
          "git diff -- *",
          "diff scripts/harness/out/*",
          "npm run quality",
          "npm run quality:*",
          "npm run test",
          "npm run build",
          "npm start",
          "npm stop",
          "npm restart",
          "npm run status",
          "STACK_PORT=5174 npm start",
          "STACK_PORT=5174 npm stop",
          "STACK_PORT=5174 npm run status",
          "node scripts/*",
          "node .kiro/skills/*",
          "npx tsc --noEmit"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*--output*",
          "git reset*",
          "git checkout*",
          "git stash*",
          "git clean*",
          "git branch -D*",
          "rm *",
          "sudo *",
          "npm install*",
          "npm i *",
          "npm uninstall*",
          "npm publish*",
          "*visual-audit*--update*",
          "*docs/qa/baselines*",
          "cp *..*",
          "node *..*",
          "cd *..*",
          "node *.kiro/powers*",
          "cd *.kiro/powers*",
          "*$(*",
          "*`*",
          "node *ship.mjs*",
          "node *release.mjs*",
          "node *tauri-local.mjs*",
          "node *build-tauri-steam*",
          "node *agents-install*",
          "node *mcp-probe*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "*.env*",
          "*.pem*",
          "*/.ssh/*",
          "*/.aws/*",
          "*.kiro/crew/.env*",
          "*netlify/config.json*",
          "*/.config/gh/*",
          "*.netrc*"
        ],
        "effect": "deny"
      },
      {
        "capability": "mcp",
        "match": [
          "*"
        ],
        "effect": "deny"
      }
    ]
  },
  "welcomeMessage": "smm-agent: which X thread, YouTube trailer, TikTok vertical hook or Steam wishlist campaign should I build?"
}
