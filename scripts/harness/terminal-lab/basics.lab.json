{
  "id": "basics",
  "title": "Basics: ls, cat, grep, a virus and a pickup",
  "room": {
    "roomKind": "lab_hall",
    "floorTheme": 2,
    "mechanic": "terminal",
    "cwd": "/lab",
    "title": "Basics",
    "summary": "Read the log, kill the virus, take the energy cell."
  },
  "player": {
    "ram": 0,
    "ssd": 0,
    "core": ""
  },
  "clock": "manual",
  "enemyFire": "live",
  "setup": [
    {
      "op": "file",
      "path": "/lab/server.log",
      "content": "ok\nFATAL disk\nok\nFATAL net\n"
    },
    {
      "op": "enemy",
      "id": "virus-1",
      "type": "virus",
      "path": "/lab/virus.exe",
      "pid": 4001,
      "ppid": 1
    },
    {
      "op": "pickup",
      "id": "energy-1",
      "type": "energy",
      "path": "/lab/energy.cell"
    },
    {
      "op": "prop",
      "id": "fan-1",
      "model": "prop.fan",
      "x": 3.8
    }
  ],
  "steps": [
    {
      "op": "run",
      "line": "ls",
      "expect": {
        "code": 0,
        "stdout": "virus.exe"
      }
    },
    {
      "op": "run",
      "line": "grep FATAL server.log | wc -l",
      "expect": {
        "code": 0,
        "stdout": "2"
      }
    },
    {
      "op": "run",
      "line": "ps",
      "expect": {
        "stdout": "4001"
      }
    },
    {
      "op": "tick",
      "n": 8,
      "expect": {
        "events": [
          "ENEMY_ATTACK"
        ],
        "absorbed": {
          "min": 1
        }
      }
    },
    {
      "op": "run",
      "line": "kill -9 4001",
      "expect": {
        "code": 0,
        "events": [
          "ENEMY_KILLED"
        ]
      }
    },
    {
      "op": "expect",
      "expect": {
        "enemiesLeft": 0
      }
    },
    {
      "op": "run",
      "line": "rm nothing.txt",
      "expect": {
        "code": 1,
        "stderr": "nothing.txt"
      }
    },
    {
      "op": "run",
      "line": "source energy.cell",
      "expect": {
        "code": 0
      }
    },
    {
      "op": "run",
      "line": "ls",
      "expect": {
        "file": {
          "path": "/lab/server.log",
          "contains": "FATAL net"
        }
      }
    }
  ]
}
