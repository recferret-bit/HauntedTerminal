{
  "id": "enemy-crack",
  "title": "Enemy: crack",
  "room": {
    "roomKind": "lab_hall",
    "floorTheme": 2,
    "mechanic": "terminal",
    "cwd": "/lab",
    "title": "Enemy: crack",
    "summary": "A crack picks sealed ports for its worm; kill the crack first, then seal the port."
  },
  "player": {
    "ram": 0,
    "ssd": 0,
    "core": ""
  },
  "clock": "manual",
  "enemyFire": "live",
  "setup": [
    {
      "op": "enemy",
      "id": "crack-1",
      "type": "crack",
      "path": "/lab/keygen.exe",
      "pid": 4001,
      "ppid": 1,
      "helps": "worm-1"
    },
    {
      "op": "enemy",
      "id": "worm-1",
      "type": "worm",
      "path": "/lab/port_445/worm.bin",
      "pid": 4002,
      "ppid": 1,
      "port": "/lab/port_445"
    },
    {
      "op": "dir",
      "path": "/lab/port_445",
      "mode": 0
    }
  ],
  "steps": [
    {
      "op": "run",
      "line": "ls",
      "expect": {
        "stdout": "keygen.exe"
      }
    },
    {
      "op": "run",
      "line": "ps",
      "expect": {
        "stdout": "4001"
      }
    },
    {
      "op": "tick",
      "n": 1,
      "expect": {
        "events": [
          "ENEMY_ATTACK"
        ]
      },
      "note": "The crack sees its worm's sealed port and winds up its lock-pick."
    },
    {
      "op": "tick",
      "n": 1,
      "expect": {
        "events": [
          "INODE_MODE_CHANGED"
        ]
      },
      "note": "Next tick, the crack reopens port_445."
    },
    {
      "op": "run",
      "line": "kill -9 4001",
      "expect": {
        "events": [
          "ENEMY_KILLED"
        ]
      }
    },
    {
      "op": "run",
      "line": "chmod 000 port_445",
      "expect": {
        "code": 0
      }
    },
    {
      "op": "tick",
      "n": 3,
      "expect": {
        "events": [
          "ENEMY_KILLED"
        ],
        "enemiesLeft": 0
      }
    }
  ]
}
