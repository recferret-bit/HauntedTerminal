{
  "id": "task-html-css",
  "title": "Task: fix a web page",
  "room": {
    "roomKind": "lab_hall",
    "floorTheme": 2,
    "mechanic": "terminal",
    "cwd": "/lab",
    "title": "Task: fix a web page",
    "summary": "Show the grid and enable the checkout button."
  },
  "player": {
    "ram": 0,
    "ssd": 0,
    "core": ""
  },
  "clock": "manual",
  "enemyFire": "live",
  "setup": [
    {
      "op": "file",
      "path": "/lab/index.html",
      "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <title>Telemetry Grid</title>\n  <link rel=\"stylesheet\" href=\"storefront.css\" />\n</head>\n<body>\n  <header class=\"site-header\">\n    <h1>HARDWARE MONITOR</h1>\n  </header>\n  <main class=\"product-grid\">\n    <article class=\"gpu-card\" data-sku=\"gpu\">\n      <h2>RTX 4090 24GB Tensor Core</h2>\n      <span class=\"price\">$1599</span>\n    </article>\n    <article class=\"gpu-card\" data-sku=\"ram\">\n      <h2>64GB DDR5 ECC Server Kit</h2>\n      <span class=\"price\">$249</span>\n    </article>\n    <article class=\"gpu-card\" data-sku=\"ssd\">\n      <h2>2TB Gen5 NVMe Weights Vault</h2>\n      <span class=\"price\">$189</span>\n    </article>\n  </main>\n  <!-- BUG: the checkout button is disabled -->\n  <aside id=\"cart-drawer\" class=\"cart-drawer\">\n    <h3>Mounted Parts</h3>\n    <p>Total Power: <span data-bind=\"cart-total\">$0.00</span></p>\n    <button id=\"checkout-btn\" type=\"button\" disabled>Mount to Server</button>\n  </aside>\n</body>\n</html>\n"
    },
    {
      "op": "file",
      "path": "/lab/storefront.css",
      "content": "/* Telemetry stylesheet */\nbody {\n  background: #0d0814;\n  color: #f4f0e8;\n}\n/* BUG: the whole grid is hidden */\n.product-grid {\n  display: none;\n  gap: 16px;\n}\n.cart-drawer {\n  width: 320px;\n  z-index: 10;\n  border: 2px solid #00f5d4;\n}\n"
    },
    {
      "op": "task",
      "id": "page",
      "rule": {
        "kind": "html_css_valid",
        "htmlPath": "/lab/index.html",
        "cssPath": "/lab/storefront.css",
        "description": "Fix the page: show the grid, enable the checkout button"
      }
    }
  ],
  "steps": [
    {
      "op": "check",
      "id": "page",
      "is": "fail"
    },
    {
      "op": "run",
      "line": "sed -i 's/display: none/display: grid/' storefront.css",
      "expect": {
        "code": 0
      }
    },
    {
      "op": "check",
      "id": "page",
      "is": "fail",
      "note": "the button is still disabled"
    },
    {
      "op": "run",
      "line": "sed -i 's/ disabled//' index.html",
      "expect": {
        "code": 0
      }
    },
    {
      "op": "check",
      "id": "page"
    }
  ]
}
