{
  "id": "enemy-trojan",
  "title": "Enemy: trojan",
  "room": {
    "roomKind": "lab_hall",
    "floorTheme": 2,
    "mechanic": "terminal",
    "cwd": "/lab",
    "title": "Enemy: trojan",
    "summary": "A trojan is a binary. Take its execute bit and it turns to stone."
  },
  "player": {
    "ram": 0,
    "ssd": 0,
    "core": ""
  },
  "clock": "manual",
  "enemyFire": "live",
  "setup": [
    {
      "op": "enemy",
      "id": "trojan-1",
      "type": "trojan",
      "path": "/lab/token_skimmer.bin"
    }
  ],
  "steps": [
    {
      "op": "run",
      "line": "ls",
      "expect": {
        "stdout": "token_skimmer.bin"
      }
    },
    {
      "op": "expect",
      "expect": {
        "enemiesLeft": 1
      }
    },
    {
      "op": "tick",
      "n": 10,
      "expect": {
        "events": [
          "ENEMY_ATTACK"
        ],
        "absorbed": {
          "min": 1
        }
      },
      "note": "It attacks; the hit is counted, never applied."
    },
    {
      "op": "run",
      "line": "chmod -x token_skimmer.bin",
      "expect": {
        "events": [
          "INODE_MODE_CHANGED"
        ]
      }
    },
    {
      "op": "expect",
      "expect": {
        "enemiesLeft": 0
      }
    }
  ]
}
