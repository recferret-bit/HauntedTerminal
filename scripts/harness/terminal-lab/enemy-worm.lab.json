{
  "id": "enemy-worm",
  "title": "Enemy: worm",
  "room": {
    "roomKind": "lab_hall",
    "floorTheme": 2,
    "mechanic": "terminal",
    "cwd": "/lab",
    "title": "Enemy: worm",
    "summary": "A worm lives in a port directory. Close the port and it starves."
  },
  "player": {
    "ram": 0,
    "ssd": 0,
    "core": ""
  },
  "clock": "manual",
  "enemyFire": "live",
  "setup": [
    {
      "op": "enemy",
      "id": "worm-1",
      "type": "worm",
      "path": "/lab/port_445/worm.bin",
      "port": "/lab/port_445"
    }
  ],
  "steps": [
    {
      "op": "run",
      "line": "ls",
      "expect": {
        "stdout": "port_445"
      }
    },
    {
      "op": "run",
      "line": "ps",
      "expect": {
        "code": 0
      }
    },
    {
      "op": "tick",
      "n": 10,
      "expect": {
        "events": [
          "ENEMY_ATTACK"
        ],
        "absorbed": {
          "min": 1
        }
      },
      "note": "It attacks; the hit is counted, never applied."
    },
    {
      "op": "run",
      "line": "chmod 000 port_445",
      "expect": {
        "events": [
          "INODE_MODE_CHANGED"
        ]
      },
      "note": "seal the port"
    },
    {
      "op": "tick",
      "n": 5,
      "expect": {
        "events": [
          "ENEMY_KILLED"
        ]
      },
      "note": "it starves after three ticks"
    },
    {
      "op": "expect",
      "expect": {
        "enemiesLeft": 0
      }
    }
  ]
}
