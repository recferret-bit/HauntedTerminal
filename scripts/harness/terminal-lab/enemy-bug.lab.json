{
  "id": "enemy-bug",
  "title": "Enemy: bug",
  "room": {
    "roomKind": "lab_hall",
    "floorTheme": 2,
    "mechanic": "terminal",
    "cwd": "/lab",
    "title": "Enemy: bug",
    "summary": "A bug lives in a line of source. Find it with grep and fix it with sed."
  },
  "player": {
    "ram": 0,
    "ssd": 0,
    "core": ""
  },
  "clock": "manual",
  "enemyFire": "live",
  "setup": [
    {
      "op": "enemy",
      "id": "bug-1",
      "type": "bug",
      "path": "/lab/prod.py"
    }
  ],
  "steps": [
    {
      "op": "run",
      "line": "ls -a",
      "expect": {
        "stdout": "prod.py"
      }
    },
    {
      "op": "tick",
      "n": 8,
      "expect": {
        "events": [
          "ENEMY_ATTACK"
        ],
        "absorbed": {
          "min": 1
        }
      },
      "note": "It attacks; the hit is counted, never applied."
    },
    {
      "op": "run",
      "line": "grep BUG prod.py",
      "expect": {
        "code": 0,
        "stdout": "BUG"
      }
    },
    {
      "op": "run",
      "line": "sed -i 's/BUG/FIXED/' prod.py",
      "expect": {
        "events": [
          "ENEMY_KILLED"
        ]
      }
    },
    {
      "op": "expect",
      "expect": {
        "enemiesLeft": 0
      }
    }
  ]
}
